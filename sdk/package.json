{
  "name": "foo-webview-sdk",
  "version": "2.0.0",
  "description": "Simplified SDK for foo_ui_webview2 - foobar2000 WebView2 Plugin",
  "type": "module",
  "main": "./dist/bridge.js",
  "module": "./dist/bridge.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/bridge.global.js",
  "sideEffects": [
    "**/*.global.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bridge.js",
      "default": "./dist/bridge.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "default": "./dist/bridge.js"
    },
    "./bridge.global": "./dist/bridge.global.js",
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "default": "./dist/components.js"
    },
    "./components.global": "./dist/components.global.js",
    "./smp-compat": {
      "types": "./dist/smp-compat.d.ts",
      "import": "./dist/smp-compat.js",
      "default": "./dist/smp-compat.js"
    },
    "./smp-compat.global": "./dist/smp-compat.global.js",
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "gen:types": "node ../scripts/gen_sdk_types.mjs --all",
    "gen:types:diff": "node ../scripts/gen_sdk_types.mjs --all --diff",
    "gen:types:validate": "node ../scripts/gen_sdk_types.mjs --all --validate",
    "gen:components-global": "node ../scripts/gen_sdk_components_global.mjs",
    "gen:components-global:diff": "node ../scripts/gen_sdk_components_global.mjs --diff --quiet",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "check-dist": "node ../scripts/check_sdk_dist.mjs",
    "build": "npm run clean:dist && tsup --config tsup.config.esm.ts && tsup --config tsup.config.iife.ts",
    "postbuild": "npm run check-dist && npm run audit:dist",
    "audit:dist": "cd .. && node scripts/audit_sourcemap.mjs --strict && node scripts/audit_dts_hygiene.mjs --strict",
    "build:esm": "tsup --config tsup.config.esm.ts",
    "build:iife": "tsup --config tsup.config.iife.ts",
    "watch": "tsup --config tsup.config.esm.ts --watch",
    "prebuild": "npm run gen:types && npm run gen:components-global:diff",
    "prepack": "npm run type-check && npm run test && npm run build"
  },
  "keywords": [
    "foobar2000",
    "webview2",
    "audio",
    "player",
    "sdk",
    "web-components",
    "music",
    "theme"
  ],
  "author": "NereaFantasia <52458173+NereaFantasia@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NereaFantasia/foo_ui_webview2.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/NereaFantasia/foo_ui_webview2#readme",
  "bugs": {
    "url": "https://github.com/NereaFantasia/foo_ui_webview2/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "vitest": "^2.1.9"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ]
}
