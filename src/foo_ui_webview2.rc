// Windows version resource. The numbers come from version.h, which
// bump-version.ps1 keeps in step with VERSION. The default theme's plugin
// release tool reads FILEVERSION and rejects a DLL whose first three parts
// differ from the release version.

#include <winres.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PLUGIN_VERSION_MAJOR,PLUGIN_VERSION_MINOR,PLUGIN_VERSION_PATCH,0
 PRODUCTVERSION PLUGIN_VERSION_MAJOR,PLUGIN_VERSION_MINOR,PLUGIN_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WebView2 UI for foobar2000"
            VALUE "FileVersion", PLUGIN_VERSION_STR
            VALUE "InternalName", "foo_ui_webview2"
            VALUE "OriginalFilename", "foo_ui_webview2.dll"
            VALUE "ProductName", "WebView2 UI"
            VALUE "ProductVersion", PLUGIN_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
